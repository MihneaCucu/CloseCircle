{
  "openapi": "3.1.0",
  "info": {
    "title": "CloseCircle location API - checkpoint integration contract",
    "version": "0.1.0-review",
    "description": "SCRUM-42 review draft for the backend slices of SCRUM-19/20/21/22 and SCRUM-43. These routes exist on unmerged feature PRs #1-5; their presence here does not make them available on dev or deployed. Auth issuance, groups, invitations, sharing changes and Android belong to their owners. Numeric freshness/accuracy policies and upload consent rules require team agreement. The wider proposed API remains in docs/api-contract.md."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local integration server after the relevant feature PRs are included."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Locations",
      "description": "Group-scoped location read/upload; no client identity override."
    }
  ],
  "paths": {
    "/api/v1/groups/{groupId}/locations/latest": {
      "parameters": [
        {
          "name": "groupId",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Uuid"
          },
          "description": "Current membership is checked server-side. Not a grant of access."
        }
      ],
      "get": {
        "operationId": "getLatestMemberLocations",
        "tags": [
          "Locations"
        ],
        "summary": "Read the latest permitted locations of other group members",
        "description": "Implemented on unmerged PR #1, with freshness in PR #3 and accuracy in PR #2. The caller and members without both sharing flags are excluded. Latest means greatest recordedAt, then locationId. Membership and sharing are rechecked on every page; this is polling, not a live subscription.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50,
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "description": "Values are clamped to 1-100. Invalid/non-int32 values return INVALID_PARAMETER."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "description": "Opaque server-issued token; pass back unchanged. Malformed, out-of-range or sub-microsecond cursors return INVALID_CURSOR."
          }
        ],
        "responses": {
          "200": {
            "description": "Permitted members, possibly an empty items array. nextCursor:null ends pagination.",
            "headers": {
              "Cache-Control": {
                "description": "Private location data must not be cached.",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LatestLocationPage"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_PARAMETER or INVALID_CURSOR.",
            "headers": {
              "Cache-Control": {
                "description": "Private location data must not be cached.",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "status": {
                          "const": 400
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid JWT or invalid canonical UUID subject. The security filter may return no body; a controller subject error returns Problem with code INVALID_TOKEN.",
            "headers": {
              "WWW-Authenticate": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^Bearer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "GROUP_NOT_FOUND for absent or inaccessible group.",
            "headers": {
              "Cache-Control": {
                "description": "Private location data must not be cached.",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "status": {
                          "const": 404
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/groups/{groupId}/locations": {
      "parameters": [
        {
          "name": "groupId",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Uuid"
          },
          "description": "Current membership is checked server-side. Not a grant of access."
        }
      ],
      "post": {
        "operationId": "uploadMemberLocation",
        "tags": [
          "Locations"
        ],
        "summary": "Upload the authenticated member's own recording",
        "description": "Implemented on unmerged PR #5 (SCRUM-43). Both current sharing flags must be on. Rejects recordings before the current sharing-preference updatedAt; future tolerance is configurable 0-300 seconds, default 0, pending team approval. Does not define retention or mobile queue behavior.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Uuid"
            },
            "description": "Stable UUID for retries of this exact normalized payload, scoped to authenticated user and group. Concurrent retries deduplicate. Reuse with different payload returns 409. Current authorization/consent is rechecked on replay. Without a key, repeated uploads create separate points."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLocationRequest"
              },
              "example": {
                "latitude": 12.3456,
                "longitude": -45.6789,
                "accuracyM": 12.5,
                "recordedAt": "2026-11-14T12:00:00+02:00"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "New persisted recording; identity, IDs and receipt time are server-derived.",
            "headers": {
              "Cache-Control": {
                "description": "Private location data must not be cached.",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Location"
                }
              }
            }
          },
          "200": {
            "description": "Identical keyed retry returns the saved representation.",
            "headers": {
              "Cache-Control": {
                "description": "Private location data must not be cached.",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Location"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_LOCATION or INVALID_UPLOAD_KEY.",
            "headers": {
              "Cache-Control": {
                "description": "Private location data must not be cached.",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "status": {
                          "const": 400
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid JWT or invalid canonical UUID subject. The security filter may return no body; a controller subject error returns Problem with code INVALID_TOKEN.",
            "headers": {
              "WWW-Authenticate": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^Bearer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "LOCATION_SHARING_DISABLED or LOCATION_CONSENT_CHANGED.",
            "headers": {
              "Cache-Control": {
                "description": "Private location data must not be cached.",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "status": {
                          "const": 403
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "GROUP_NOT_FOUND for absent membership or inaccessible group.",
            "headers": {
              "Cache-Control": {
                "description": "Private location data must not be cached.",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "status": {
                          "const": 404
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "IDEMPOTENCY_CONFLICT: this key was used with a different normalized payload.",
            "headers": {
              "Cache-Control": {
                "description": "Private location data must not be cached.",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "status": {
                          "const": 409
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Content-Type; send application/json. Framework error body is not part of this contract."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "HS256, issuer closecircle, canonical UUID sub; no token issuance in this slice."
      }
    },
    "schemas": {
      "Uuid": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      },
      "CreateLocationRequest": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "accuracyM": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "latitude",
          "longitude",
          "recordedAt"
        ],
        "additionalProperties": false,
        "description": "Offset-bearing device recording time is required; optional/null accuracy is metres. Unknown fields are rejected. Server applies future tolerance and current-consent checks; a schema cannot authorize an upload."
      },
      "Location": {
        "type": "object",
        "properties": {
          "locationId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "groupId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "userId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "accuracyM": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "locationId",
          "groupId",
          "userId",
          "latitude",
          "longitude",
          "accuracyM",
          "recordedAt",
          "receivedAt"
        ],
        "description": "Server-generated identity and receipt time. Timestamps are normalized to microsecond UTC precision. Clients must tolerate additional response fields."
      },
      "Freshness": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "RECENT",
              "LAST_KNOWN",
              "UNKNOWN"
            ]
          },
          "evaluatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "recentForSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          }
        },
        "required": [
          "status",
          "evaluatedAt",
          "recentForSeconds"
        ],
        "description": "Present only when recent-for-seconds is configured. One evaluatedAt per page. Uses recordedAt, not receivedAt; inclusive recent boundary; missing/future point UNKNOWN. No approved product window."
      },
      "Accuracy": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ACCEPTABLE",
              "POOR",
              "UNKNOWN"
            ]
          },
          "poorAccuracyThresholdM": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "status",
          "poorAccuracyThresholdM"
        ],
        "description": "Present only when an accuracy threshold is configured. Independent of freshness. No approved product threshold."
      },
      "LatestLocation": {
        "type": "object",
        "properties": {
          "userId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "displayName": {
            "type": "string"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Location"
              },
              {
                "type": "null"
              }
            ]
          },
          "freshness": {
            "$ref": "#/components/schemas/Freshness"
          },
          "accuracy": {
            "$ref": "#/components/schemas/Accuracy"
          }
        },
        "required": [
          "userId",
          "displayName",
          "location"
        ],
        "description": "Only permitted other members are included. A visible member without a point has location:null. Disabled metadata is omitted, never null."
      },
      "LatestLocationPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/LatestLocation"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200,
            "minLength": 1
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri-reference"
          },
          "code": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "description": "Controller-generated application/problem+json. Security-filter 401 responses can be empty; do not require this object for every authentication failure."
      }
    }
  }
}
