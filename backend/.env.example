# Local PostgreSQL is provided by infra/compose.yaml. Never put production values here.
DATABASE_URL=jdbc:postgresql://localhost:5432/closecircle?sslmode=disable
DATABASE_URL_UNPOOLED=jdbc:postgresql://localhost:5432/closecircle?sslmode=disable
DATABASE_USERNAME=closecircle
DATABASE_PASSWORD=closecircle
DB_POOL_MAX_SIZE=5
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=8080
